    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.11",
    "mermaid": "^12.0.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.6.7",
